/////////////////////////////////////////////////////////////////////////////
//
// Icono
//

// Icono con el valor de id. menor colocado en primer lugar para garantizar que el icono de la aplicación
// es el mismo en todos los sistemas.

#if !defined(AFX_RESOURCE_DLL) || defined(AFX_TARG_ESO)
LANGUAGE 10, 9
#pragma code_page(1252)
IDR_MAINFRAME           ICON         "res\\Trafico.ico"
IDR_TraficoTYPE         ICON         "res\\TraficoDoc.ico"
#endif
/////////////////////////////////////////////////////////////////////////////
//
// Mapa de bits
//

IDR_MAINFRAME           BITMAP      "res\\Toolbar.bmp"

/////////////////////////////////////////////////////////////////////////////
//
// Barra de herramientas
//

IDR_MAINFRAME TOOLBAR   16, 15
BEGIN
    BUTTON      ID_FILE_NEW
    BUTTON      ID_FILE_OPEN
    BUTTON      ID_FILE_SAVE
	SEPARATOR
    BUTTON      ID_EDIT_CUT
    BUTTON      ID_EDIT_COPY
    BUTTON      ID_EDIT_PASTE
	SEPARATOR
    BUTTON      ID_FILE_PRINT
    BUTTON      ID_APP_ABOUT
END




#if !defined(AFX_RESOURCE_DLL) || defined(AFX_TARG_ESO)
LANGUAGE 10, 9
#pragma code_page(1252)
/////////////////////////////////////////////////////////////////////////////
//
// Menú
//

IDR_MAINFRAME MENU   
BEGIN
	POPUP "&Archivo"
	BEGIN
		MENUITEM "&Nuevo\tCtrl+N",                ID_FILE_NEW
		MENUITEM "&Abrir...\tCtrl+O",            ID_FILE_OPEN
		MENUITEM "&Guardar\tCtrl+S",               ID_FILE_SAVE
		MENUITEM "Guardar &como...",                 ID_FILE_SAVE_AS
		MENUITEM SEPARATOR
		MENUITEM "&Imprimir...\tCtrl+P",           ID_FILE_PRINT
		MENUITEM "&Vista preliminar",              ID_FILE_PRINT_PREVIEW
		MENUITEM "&Configurar impresión...",             ID_FILE_PRINT_SETUP
		MENUITEM SEPARATOR
		MENUITEM "Archivo reciente",                 ID_FILE_MRU_FILE1,GRAYED
		MENUITEM SEPARATOR
		MENUITEM "&Salir",                       ID_APP_EXIT
	END
	POPUP "&Edición"
	BEGIN
		MENUITEM "&Deshacer\tCtrl+Z",               ID_EDIT_UNDO
		MENUITEM SEPARATOR
		MENUITEM "Cor&tar\tCtrl+X",                ID_EDIT_CUT
		MENUITEM "&Copiar\tCtrl+C",               ID_EDIT_COPY
		MENUITEM "&Pegar\tCtrl+V",              ID_EDIT_PASTE
	END
	POPUP "&Ver"
	BEGIN
		MENUITEM "&Barra de herramientas",                    ID_VIEW_TOOLBAR
		MENUITEM "&Barra de estado",                 ID_VIEW_STATUS_BAR
	END
	POPUP "Ay&uda"
	BEGIN
		MENUITEM "&Acerca de Trafico...",          ID_APP_ABOUT
	END
END



/////////////////////////////////////////////////////////////////////////////
//
// Acelerador
//

IDR_MAINFRAME ACCELERATORS   
BEGIN
	"N",            ID_FILE_NEW,            VIRTKEY,CONTROL
	"O",            ID_FILE_OPEN,           VIRTKEY,CONTROL
	"S",            ID_FILE_SAVE,           VIRTKEY,CONTROL
	"P",            ID_FILE_PRINT,          VIRTKEY,CONTROL
	"Z",            ID_EDIT_UNDO,           VIRTKEY,CONTROL
	"X",            ID_EDIT_CUT,            VIRTKEY,CONTROL
	"C",            ID_EDIT_COPY,           VIRTKEY,CONTROL
	"V",            ID_EDIT_PASTE,          VIRTKEY,CONTROL
	VK_BACK,        ID_EDIT_UNDO,           VIRTKEY,ALT
	VK_DELETE,      ID_EDIT_CUT,            VIRTKEY,SHIFT
	VK_INSERT,      ID_EDIT_COPY,           VIRTKEY,CONTROL
	VK_INSERT,      ID_EDIT_PASTE,          VIRTKEY,SHIFT
	VK_F6,          ID_NEXT_PANE,           VIRTKEY 
	VK_F6,          ID_PREV_PANE,           VIRTKEY,SHIFT
END




/////////////////////////////////////////////////////////////////////////////
//
// Cuadro de diálogo
//

IDD_ABOUTBOX DIALOGEX   0, 0, 235, 55
CAPTION "Acerca de Trafico"
STYLE DS_MODALFRAME | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
FONT 8, "MS Shell Dlg"
BEGIN
	ICON            IDR_MAINFRAME,IDC_STATIC,11,17,20,20
	LTEXT           "Trafico versión 1.0",IDC_STATIC,40,10,119,8,
                    SS_NOPREFIX
	LTEXT           "Copyright (C) 2006",IDC_STATIC,40,25,119,8
	DEFPUSHBUTTON   "Aceptar",IDOK,178,7,50,16,WS_GROUP
END



/////////////////////////////////////////////////////////////////////////////
//
// Versión
//

VS_VERSION_INFO     VERSIONINFO
  FILEVERSION       1,0,0,1
  PRODUCTVERSION    1,0,0,1
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x4L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
	BLOCK "StringFileInfo"
	BEGIN
        BLOCK "0c0a04e4"
		BEGIN 
            VALUE "CompanyName", "TODO: <Nombre de la compañía>"
            VALUE "FileDescription", "TODO: <Descripción del archivo>"
			VALUE "FileVersion",     "1.0.0.1"
			VALUE "InternalName",    "Trafico.exe"
            VALUE "LegalCopyright", "TODO: (c) <Nombre de la compañía>. Reservados todos los derechos."
			VALUE "OriginalFilename","Trafico.exe"
            VALUE "ProductName", "TODO: <Nombre del producto>"
			VALUE "ProductVersion",  "1.0.0.1"
		END
	END
	BLOCK "VarFileInfo" 
	BEGIN 
		VALUE "Translation", 0x0c0a, 1252
    END
END

/////////////////////////////////////////////////////////////////////////////
//
// DESIGNINFO
//

#ifdef APSTUDIO_INVOKED
GUIDELINES DESIGNINFO  
BEGIN
    IDD_ABOUTBOX, DIALOG
    BEGIN
        LEFTMARGIN, 7
        RIGHTMARGIN, 228
        TOPMARGIN, 7
        BOTTOMMARGIN, 48
    END
END
